# انسخ هذا الملف باسم .env واملأ القيم الحقيقية (لا يُرفع .env على GitHub أبدًا)

# Supabase → Project Settings → Database → Connection string
# "Connection pooling" (Transaction mode, المنفذ 6543) يُستخدم أثناء تشغيل الموقع
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# "Direct connection" (المنفذ 5432) يُستخدم فقط عند تشغيل prisma migrate
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# نص عشوائي — وَلِّده بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- الفوترة والاشتراكات (Phase 14) ---

# PayPal Developer → Apps & Credentials (Sandbox أو Live)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox" # أو "live"

# تُعرَض للعميل كتعليمات دفع يدوي — بدون قيم افتراضية حقيقية إلى أن تُملأ هنا
VODAFONE_CASH_NUMBER=""
AL_RAJHI_ACCOUNT_NAME=""
AL_RAJHI_IBAN=""

# اختياري — يحمي GET /api/cron/check-subscriptions من الاستدعاء العام؛ إن ضُبط، يجب
# أن يرسل Vercel Cron نفس القيمة في Header باسم Authorization: Bearer <القيمة>
CRON_SECRET=""

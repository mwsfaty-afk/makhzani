// ============================================================================
// STOCK PROG — Multi-Tenant Inventory / Sales / Purchases SaaS
// Prisma Schema — هذا الملف هو الوثيقة الرسمية لقاعدة البيانات (ERD + Schema)
// DB: PostgreSQL (Supabase) — راجع docs/ARCHITECTURE.md لشرح القرارات
// ملاحظة Supabase: DATABASE_URL يشير لـ Connection Pooler (pgbouncer, للتطبيق وقت التشغيل)
// و DIRECT_URL يشير للاتصال المباشر (لأوامر migrate فقط) — كلاهما مطلوب مع Prisma.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1) PLATFORM LEVEL — لا يوجد companyId هنا (خارج نطاق الـ Tenant)
// ============================================================================

model PlatformAdmin {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Plan {
  id           Int     @id @default(autoincrement())
  code         String  @unique // trial, basic, professional, enterprise
  name         String
  nameAr       String
  description  String?
  price        Decimal @db.Decimal(12, 2)
  currency     String  @default("USD")
  durationDays Int // 30, 365, أو 0 = Trial بدون تجديد تلقائي
  isTrial      Boolean @default(false)
  isActive     Boolean @default(true)
  isPublic     Boolean @default(true) // يظهر في صفحة الأسعار

  // الحدود — Limits من قاعدة البيانات وليست Hard-coded (بند 47)
  maxUsers            Int
  maxBranches         Int
  maxWarehouses       Int
  maxItems            Int
  maxCustomers        Int
  maxSuppliers        Int
  maxMonthlyDocuments Int // فواتير بيع/شراء شهريًا
  maxStorageMb        Int

  // مفاتيح ميزات إضافية قابلة للتوسع بدون تعديل السكيمة
  features Json @default("{}") // { "advancedReports": true, "api": false, ... }

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  prices        PlanPrice[]
}

// سعر الخطة لكل دولة مستهدفة — بديل عن price/currency الافتراضيين أعلاه عند وجود سطر مطابق
// للدولة. مثال: SA → SAR، EG → EGP، وأي دولة أخرى تستخدم سعر Plan.price/currency الافتراضي
// (المقترح: EGP) دون الحاجة لإضافة سطر خاص بها.
model PlanPrice {
  id          Int      @id @default(autoincrement())
  planId      Int
  plan        Plan     @relation(fields: [planId], references: [id])
  countryCode String // ISO 3166-1 alpha-2: "SA", "EG" ...
  currency    String // "SAR", "EGP" ...
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([planId, countryCode])
}

// أسعار صرف تقريبية تُحدَّث يدويًا من لوحة SaaS Admin — لغرض العرض فقط (ملحوظة توضيحية
// بجانب السعر الأساسي، مثل: "499 ج.م (≈ 65 ر.س / 10 $)")، وليست مصدرًا للفوترة الفعلية.
model ExchangeRateNote {
  id             Int      @id @default(autoincrement())
  baseCurrency   String // "EGP"
  targetCurrency String // "SAR" | "USD"
  rate           Decimal  @db.Decimal(12, 6)
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  companyId          Int                @unique
  company            Company            @relation(fields: [companyId], references: [id])
  planId             Int
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  trialStart         DateTime?
  trialEnd           DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments Payment[]

  @@index([status, currentPeriodEnd])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id             Int           @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  companyId      Int
  amount         Decimal       @db.Decimal(12, 2)
  currency       String
  status         PaymentStatus @default(PENDING)
  gateway        String // "paymob" | "stripe" | "fawry" | "manual" ...
  gatewayRef     String?
  invoiceNumber  String?       @unique
  paidAt         DateTime?
  meta           Json          @default("{}")
  createdAt      DateTime      @default(now())

  @@index([companyId])
}

// ============================================================================
// 2) TENANT ROOT
// ============================================================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Company {
  id                 Int           @id @default(autoincrement())
  name               String
  ownerName          String
  email              String        @unique
  phone              String?
  country            String // ISO code: EG, SA, JO, AE ...
  currency           String // ISO code: EGP, SAR, JOD, AED ...
  currencySymbol     String        @default("")
  decimalPlaces      Int           @default(2)
  businessType       String?
  timezone           String        @default("Africa/Cairo")
  locale             String        @default("ar") // لدعم en مستقبلًا بدون تعديل بنيوي
  logoUrl            String?
  status             CompanyStatus @default(ACTIVE)
  allowNegativeStock Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subscription      Subscription?
  users             User[]
  branches          Branch[]
  warehouses        Warehouse[]
  roles             Role[]
  items             Item[]
  categories        Category[]
  brands            Brand[]
  units             Unit[]
  customers         Customer[]
  suppliers         Supplier[]
  cashboxes         CashBox[]
  settings          Setting[]
  documentSequences DocumentSequence[]
  auditLogs         AuditLog[]
  notifications     Notification[]
}

// ============================================================================
// 3) USERS / ROLES / PERMISSIONS — Permission-Based Access Control
// ============================================================================

model User {
  id           Int       @id @default(autoincrement())
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id])
  name         String
  email        String
  phone        String?
  passwordHash String
  roleId       Int?
  role         Role?     @relation(fields: [roleId], references: [id])
  isOwner      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userPermissions UserPermission[]
  userWarehouses  UserWarehouse[]

  @@unique([companyId, email])
  @@index([companyId])
}

model Role {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isSystem  Boolean  @default(false) // Owner/Admin مبدئية لا تُحذف
  createdAt DateTime @default(now())

  users           User[]
  rolePermissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
}

// كتالوج الصلاحيات عام على مستوى المنصة (ليس per-tenant)
model Permission {
  id      Int    @id @default(autoincrement())
  module  String // "items" | "sales" | "purchases" | "stock" | "reports" | ...
  action  String // "view" | "create" | "edit" | "delete" | "print" | "approve" | "cancel" | "export"
  code    String @unique // "items.view", "sales.approve" ...
  label   String
  labelAr String

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

enum PermissionEffect {
  GRANT
  DENY
}

// استثناءات فردية فوق صلاحيات الـ Role
model UserPermission {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation(fields: [userId], references: [id])
  permissionId Int
  permission   Permission       @relation(fields: [permissionId], references: [id])
  effect       PermissionEffect @default(GRANT)

  @@unique([userId, permissionId])
}

// تقييد المستخدم بمخازن محددة (بند 38)
model UserWarehouse {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([userId, warehouseId])
}

// ============================================================================
// 4) BRANCHES / WAREHOUSES / LOCATIONS
// ============================================================================

model Branch {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  warehouses Warehouse[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  code        String
  name        String
  address     String?
  managerName String?
  phone       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  locations        WarehouseLocation[]
  userWarehouses   UserWarehouse[]
  purchaseOrders   PurchaseOrder[]
  purchases        Purchase[]
  salesOrders      SalesOrder[]
  sales            Sale[]
  stockMovements   StockMovement[]
  stockBalances    StockBalance[]
  stockAdjustments StockAdjustment[]

  @@unique([companyId, code])
  @@index([companyId])
}

model WarehouseLocation {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  name        String?
  isActive    Boolean   @default(true)

  @@unique([warehouseId, code])
}

// ============================================================================
// 5) MASTER DATA — Categories / Brands / Units / Items
// ============================================================================

model Category {
  id        Int        @id @default(autoincrement())
  companyId Int
  company   Company    @relation(fields: [companyId], references: [id])
  parentId  Int?
  parent    Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSub")
  name      String
  isActive  Boolean    @default(true)

  items Item[]

  @@index([companyId])
}

model Brand {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  logoUrl   String?
  isActive  Boolean @default(true)

  items Item[]

  @@index([companyId])
}

model Unit {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  nameAr    String

  @@unique([companyId, name])
  @@index([companyId])
}

model Item {
  id         Int       @id @default(autoincrement())
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id])
  code       String
  barcode    String?
  name       String
  nameAr     String?
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    Int?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  baseUnitId         Int
  purchaseUnitId     Int?
  salesUnitId        Int?
  purchaseUnitFactor Decimal @default(1) @db.Decimal(18, 6) // 1 كرتونة = N قطعة
  salesUnitFactor    Decimal @default(1) @db.Decimal(18, 6)

  purchasePrice Decimal @default(0) @db.Decimal(18, 4) // آخر سعر شراء (مرجعي فقط)
  salePrice     Decimal @default(0) @db.Decimal(18, 4)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)

  minStock     Decimal @default(0) @db.Decimal(18, 4)
  maxStock     Decimal @default(0) @db.Decimal(18, 4)
  reorderPoint Decimal @default(0) @db.Decimal(18, 4)

  imageUrl    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, barcode])
}

// ============================================================================
// 6) CUSTOMERS / SUPPLIERS
// ============================================================================

model Customer {
  id             Int      @id @default(autoincrement())
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  code           String
  name           String
  phone          String?
  email          String?
  address        String?
  taxNumber      String?
  creditLimit    Decimal  @default(0) @db.Decimal(18, 4)
  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  salesRepUserId Int?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  transactions CustomerTransaction[]
  salesOrders  SalesOrder[]
  sales        Sale[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Supplier {
  id             Int      @id @default(autoincrement())
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  code           String
  name           String
  phone          String?
  email          String?
  address        String?
  taxNumber      String?
  creditLimit    Decimal  @default(0) @db.Decimal(18, 4)
  openingBalance Decimal  @default(0) @db.Decimal(18, 4)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  transactions   SupplierTransaction[]
  purchaseOrders PurchaseOrder[]
  purchases      Purchase[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ============================================================================
// 7) DOCUMENT STATUS (مشترك لكل المستندات)
// ============================================================================

enum DocStatus {
  DRAFT
  PENDING
  APPROVED
  POSTED
  CANCELLED
  REJECTED
}

// ============================================================================
// 8) PURCHASES
// ============================================================================

model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  companyId   Int
  docNo       String
  date        DateTime
  supplierId  Int
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      DocStatus @default(DRAFT)
  notes       String?
  userId      Int
  createdAt   DateTime  @default(now())

  items PurchaseOrderItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemId          Int
  unitId          Int
  qty             Decimal       @db.Decimal(18, 4)
  unitPrice       Decimal       @db.Decimal(18, 4)
}

model Purchase {
  id                Int       @id @default(autoincrement())
  companyId         Int
  docNo             String // PUR-2026-000001
  date              DateTime
  supplierId        Int
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId       Int
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  supplierInvoiceNo String?
  subtotal          Decimal   @db.Decimal(18, 4)
  discountTotal     Decimal   @default(0) @db.Decimal(18, 4)
  taxTotal          Decimal   @default(0) @db.Decimal(18, 4)
  grandTotal        Decimal   @db.Decimal(18, 4)
  paidAmount        Decimal   @default(0) @db.Decimal(18, 4)
  remainingAmount   Decimal   @default(0) @db.Decimal(18, 4)
  paymentMethod     String? // "cash" | "credit" | "bank"
  status            DocStatus @default(DRAFT)
  notes             String?
  userId            Int
  postedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())

  items           PurchaseItem[]
  purchaseReturns PurchaseReturn[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
  @@index([companyId, date])
}

model PurchaseItem {
  id              Int      @id @default(autoincrement())
  purchaseId      Int
  purchase        Purchase @relation(fields: [purchaseId], references: [id])
  itemId          Int
  unitId          Int
  qty             Decimal  @db.Decimal(18, 4)
  bonusQty        Decimal  @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 4)
  discount        Decimal  @default(0) @db.Decimal(18, 4)
  tax             Decimal  @default(0) @db.Decimal(18, 4)
  total           Decimal  @db.Decimal(18, 4)
  costPerBaseUnit Decimal  @db.Decimal(18, 6) // بعد تحويل الوحدة للـ Base Unit
}

model PurchaseReturn {
  id         Int       @id @default(autoincrement())
  companyId  Int
  docNo      String
  date       DateTime
  purchaseId Int
  purchase   Purchase  @relation(fields: [purchaseId], references: [id])
  reason     String?
  status     DocStatus @default(DRAFT)
  userId     Int
  postedAt   DateTime?
  createdAt  DateTime  @default(now())

  items PurchaseReturnItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  itemId           Int
  qty              Decimal        @db.Decimal(18, 4)
  unitPrice        Decimal        @db.Decimal(18, 4)
  total            Decimal        @db.Decimal(18, 4)
}

// ============================================================================
// 9) SALES
// ============================================================================

model SalesOrder {
  id          Int       @id @default(autoincrement())
  companyId   Int
  docNo       String
  date        DateTime
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      DocStatus @default(DRAFT)
  notes       String?
  userId      Int
  createdAt   DateTime  @default(now())

  items SalesOrderItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  itemId       Int
  unitId       Int
  qty          Decimal    @db.Decimal(18, 4)
  unitPrice    Decimal    @db.Decimal(18, 4)
}

model Sale {
  id              Int       @id @default(autoincrement())
  companyId       Int
  docNo           String // SAL-2026-000001
  date            DateTime
  customerId      Int
  customer        Customer  @relation(fields: [customerId], references: [id])
  warehouseId     Int
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  branchId        Int?
  subtotal        Decimal   @db.Decimal(18, 4)
  discountTotal   Decimal   @default(0) @db.Decimal(18, 4)
  taxTotal        Decimal   @default(0) @db.Decimal(18, 4)
  grandTotal      Decimal   @db.Decimal(18, 4)
  paidAmount      Decimal   @default(0) @db.Decimal(18, 4)
  remainingAmount Decimal   @default(0) @db.Decimal(18, 4)
  totalCost       Decimal   @default(0) @db.Decimal(18, 4) // COGS للفاتورة كاملة
  totalProfit     Decimal   @default(0) @db.Decimal(18, 4)
  paymentMethod   String?
  status          DocStatus @default(DRAFT)
  notes           String?
  userId          Int
  postedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  items       SaleItem[]
  saleReturns SaleReturn[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
  @@index([companyId, date])
  @@index([companyId, customerId])
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int
  sale            Sale    @relation(fields: [saleId], references: [id])
  itemId          Int
  unitId          Int
  qty             Decimal @db.Decimal(18, 4)
  unitPrice       Decimal @db.Decimal(18, 4)
  discount        Decimal @default(0) @db.Decimal(18, 4)
  tax             Decimal @default(0) @db.Decimal(18, 4)
  costPerBaseUnit Decimal @db.Decimal(18, 6) // متوسط التكلفة وقت البيع (Moving Average)
  totalCost       Decimal @db.Decimal(18, 4)
  profit          Decimal @db.Decimal(18, 4)
  total           Decimal @db.Decimal(18, 4)
}

model SaleReturn {
  id           Int       @id @default(autoincrement())
  companyId    Int
  docNo        String
  date         DateTime
  saleId       Int
  sale         Sale      @relation(fields: [saleId], references: [id])
  reason       String?
  refundMethod String? // "cash" | "customer_credit"
  status       DocStatus @default(DRAFT)
  userId       Int
  postedAt     DateTime?
  createdAt    DateTime  @default(now())

  items SaleReturnItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model SaleReturnItem {
  id           Int        @id @default(autoincrement())
  saleReturnId Int
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id])
  itemId       Int
  qty          Decimal    @db.Decimal(18, 4)
  unitPrice    Decimal    @db.Decimal(18, 4)
  total        Decimal    @db.Decimal(18, 4)
}

// ============================================================================
// 10) STOCK MOVEMENT ENGINE — القلب المركزي للمخزون (بند 26)
// لا يوجد تعديل يدوي للرصيد؛ الرصيد = SUM(qtyIn) - SUM(qtyOut)
// ============================================================================

enum MovementType {
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  STOCK_ADJUSTMENT_IN
  STOCK_ADJUSTMENT_OUT
  DAMAGE
  OPENING_BALANCE
}

model StockMovement {
  id           BigInt       @id @default(autoincrement())
  companyId    Int
  itemId       Int
  item         Item         @relation(fields: [itemId], references: [id])
  warehouseId  Int
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  locationId   Int?
  movementDate DateTime
  movementType MovementType
  documentType String // "purchase" | "sale" | "transfer" | "adjustment" | ...
  documentId   Int
  documentNo   String
  qtyIn        Decimal      @default(0) @db.Decimal(18, 4)
  qtyOut       Decimal      @default(0) @db.Decimal(18, 4)
  unitCost     Decimal      @db.Decimal(18, 6) // Moving Average وقت الحركة
  totalCost    Decimal      @db.Decimal(18, 4)
  balanceAfter Decimal      @db.Decimal(18, 4) // Snapshot للأداء ولل Stock Card
  userId       Int
  notes        String?
  createdAt    DateTime     @default(now())

  @@index([companyId, itemId, warehouseId, movementDate])
  @@index([companyId, documentType, documentId])
}

// Cache/Balance Table لتحسين الأداء بدل SUM على كل قراءة (بند 26)
model StockBalance {
  id          Int       @id @default(autoincrement())
  companyId   Int
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qty         Decimal   @default(0) @db.Decimal(18, 4)
  avgCost     Decimal   @default(0) @db.Decimal(18, 6) // Moving Average الحالي
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, itemId, warehouseId])
  @@index([companyId, warehouseId])
}

model StockAdjustment {
  id          Int       @id @default(autoincrement())
  companyId   Int
  docNo       String
  date        DateTime
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  reason      String // "opening" | "damage" | "consumption" | "sample" | "other"
  direction   String // "IN" | "OUT"
  status      DocStatus @default(DRAFT)
  userId      Int
  postedAt    DateTime?
  createdAt   DateTime  @default(now())

  items StockAdjustmentItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model StockAdjustmentItem {
  id                Int             @id @default(autoincrement())
  stockAdjustmentId Int
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id])
  itemId            Int
  qty               Decimal         @db.Decimal(18, 4)
  unitCost          Decimal         @db.Decimal(18, 6)
}

model StockTransfer {
  id              Int       @id @default(autoincrement())
  companyId       Int
  docNo           String
  date            DateTime
  fromWarehouseId Int
  toWarehouseId   Int
  status          DocStatus @default(DRAFT)
  notes           String?
  userId          Int
  postedAt        DateTime?
  createdAt       DateTime  @default(now())

  items StockTransferItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model StockTransferItem {
  id              Int           @id @default(autoincrement())
  stockTransferId Int
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id])
  itemId          Int
  qty             Decimal       @db.Decimal(18, 4)
  unitCost        Decimal       @db.Decimal(18, 6)
}

model StockTake {
  id          Int       @id @default(autoincrement())
  companyId   Int
  docNo       String
  date        DateTime
  warehouseId Int
  scope       String // "full" | "category" | "items"
  status      DocStatus @default(DRAFT)
  userId      Int
  postedAt    DateTime?
  createdAt   DateTime  @default(now())

  items StockTakeItem[]

  @@unique([companyId, docNo])
  @@index([companyId, status])
}

model StockTakeItem {
  id          Int       @id @default(autoincrement())
  stockTakeId Int
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id])
  itemId      Int
  bookQty     Decimal   @db.Decimal(18, 4)
  actualQty   Decimal   @db.Decimal(18, 4)
  unitCost    Decimal   @db.Decimal(18, 6)
}

// ============================================================================
// 11) CASH / FINANCIAL LEDGERS
// ============================================================================

model CashBox {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  type      String // "cash" | "bank"
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions CashTransaction[]

  @@index([companyId])
}

enum CashTransactionType {
  RECEIPT
  PAYMENT
  TRANSFER
  CUSTOMER_COLLECTION
  SUPPLIER_PAYMENT
}

model CashTransaction {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  cashBoxId         Int
  cashBox           CashBox             @relation(fields: [cashBoxId], references: [id])
  type              CashTransactionType
  amount            Decimal             @db.Decimal(18, 4)
  direction         String // "IN" | "OUT"
  date              DateTime
  documentType      String? // "sale" | "purchase" | "customer_collection" | ...
  documentId        Int?
  relatedCustomerId Int?
  relatedSupplierId Int?
  notes             String?
  userId            Int
  createdAt         DateTime            @default(now())

  @@index([companyId, cashBoxId, date])
}

model CustomerTransaction {
  id           Int      @id @default(autoincrement())
  companyId    Int
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id])
  type         String // "sale" | "sale_return" | "collection" | "opening_balance"
  documentType String?
  documentId   Int?
  debit        Decimal  @default(0) @db.Decimal(18, 4) // مديونية على العميل (فاتورة بيع)
  credit       Decimal  @default(0) @db.Decimal(18, 4) // سداد/مرتجع
  balanceAfter Decimal  @db.Decimal(18, 4)
  date         DateTime
  notes        String?
  createdAt    DateTime @default(now())

  @@index([companyId, customerId, date])
}

model SupplierTransaction {
  id           Int      @id @default(autoincrement())
  companyId    Int
  supplierId   Int
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  type         String // "purchase" | "purchase_return" | "payment" | "opening_balance"
  documentType String?
  documentId   Int?
  debit        Decimal  @default(0) @db.Decimal(18, 4) // سداد لنا/مرتجع
  credit       Decimal  @default(0) @db.Decimal(18, 4) // مديونية علينا (فاتورة شراء)
  balanceAfter Decimal  @db.Decimal(18, 4)
  date         DateTime
  notes        String?
  createdAt    DateTime @default(now())

  @@index([companyId, supplierId, date])
}

// ============================================================================
// 12) NOTIFICATIONS / AUDIT / SETTINGS / DOCUMENT NUMBERING
// ============================================================================

model Notification {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  userId    Int? // null = لكل مستخدمي الشركة المخوَّلين
  type      String // "low_stock" | "out_of_stock" | "invoice_due" | "credit_limit" | "subscription_expiring" | ...
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, userId, isRead])
}

// منع الحذف الفعلي (بند 39) — لا يوجد Delete API لهذا الجدول إطلاقًا
model AuditLog {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  userId    Int?
  action    String // "create" | "update" | "delete" | "approve" | "cancel" | "login" | "logout" | "password_change" | "permission_change" | ...
  module    String
  tableName String?
  recordId  Int?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId, module, createdAt])
  @@index([companyId, userId, createdAt])
}

model Setting {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  value     Json

  @@unique([companyId, key])
}

// ترقيم المستندات القابل للتخصيص (بند 54)
model DocumentSequence {
  id           Int     @id @default(autoincrement())
  companyId    Int
  company      Company @relation(fields: [companyId], references: [id])
  docType      String // "purchase" | "sale" | "purchase_return" | "sale_return" | "transfer" | "stock_in" | "stock_out" | "stock_take"
  prefix       String // "PUR" ...
  yearInNumber Boolean @default(true)
  padLength    Int     @default(6)
  nextNumber   Int     @default(1)

  @@unique([companyId, docType])
}
